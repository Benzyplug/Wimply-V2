generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GuildConfig {
  id              String         @id @default(cuid())
  guildId         String         @unique
  name            String?
  currencyName    String         @default("Coins")
  currencyEmoji   String         @default("🪙")
  dailyCooldown   Int            @default(24)
  weeklyCooldown  Int            @default(168)
  monthlyCooldown Int            @default(720)
  workCooldown    Int            @default(3)
  crimeCooldown   Int            @default(3)
  robCooldown     Int            @default(4)
  begCooldown     Int            @default(1)
  taxPercent      Int            @default(10)
  interestRate    Float          @default(0.01)
  xpEnabled       Boolean        @default(true)
  xpPerMessage    Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           Item[]         
  reactionRules   ReactionRule[]
  users           User[]
}

model User {
  id           String               @id @default(cuid())
  discordId    String
  guildId      String
  wallet       BigInt               @default(0)
  bank         BigInt               @default(0)
  xp           Int                  @default(0)
  level        Int                  @default(1)
  badges       String[]             @default([])
  joinedAt     DateTime             @default(now())
  lastDaily    DateTime?
  lastWeekly   DateTime?
  lastMonthly  DateTime?
  lastWork     DateTime?
  lastCrime    DateTime?
  lastRob      DateTime?
  lastBeg      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions EconomyTransaction[]
  inventory    InventoryItem[]
  guild        GuildConfig          @relation(fields: [guildId], references: [id])

  @@unique([discordId, guildId])
  @@index([guildId])
}

model Item {
  id          String          @id @default(cuid())
  guildId     String
  name        String
  description String
  emoji       String
  category    String
  price       BigInt
  sellPrice   BigInt
  stock       Int?
  limited     Boolean         @default(false)
  stackable   Boolean         @default(true)
  usable      Boolean         @default(false)
  boostType   String?
  boostValue  Int?
  boostTarget String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inventory   InventoryItem[]
  guild       GuildConfig     @relation(fields: [guildId], references: [id])

  @@index([guildId, name])
}

model InventoryItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())
  item       Item     @relation(fields: [itemId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
}

model EconomyTransaction {
  id           String          @id @default(cuid())
  userId       String?
  source       String
  amount       BigInt
  balanceAfter BigInt
  type         TransactionType
  description  String
  createdAt    DateTime        @default(now())
  user         User?           @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ReactionRule {
  id        String      @id @default(cuid())
  guildId   String
  trigger   String
  emoji     String
  channelId String
  createdAt DateTime    @default(now())
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, channelId])
}

enum TransactionType {
  BALANCE
  DAILY
  WEEKLY
  MONTHLY
  WORK
  CRIME
  BEG
  DEPOSIT
  WITHDRAW
  PAY
  ROB
  PURCHASE
  SELL
  ADMIN
}